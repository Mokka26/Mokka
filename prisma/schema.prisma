generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String   @db.Text
  price        Float    // verkoopprijs (wat de klant betaalt)
  listPrice    Float?   // adviesprijs; indien > price → korting (doorgestreept)
  category     String
  images       String   @db.Text
  specs        String?  @db.Text
  // Maat-varianten met eigen prijs (JSON-array), bv. bedden:
  // [{"label":"140 × 200","price":599},{"label":"160 × 200","price":699}]
  // Leeg/null = product met één vaste prijs (price-veld).
  sizeVariants String?  @db.Text
  // Nachtkast-optie (bedden), per bed in te stellen in de admin:
  //   nachtkastMode: "included" (inbegrepen), "optional" (apart bij te
  //   bestellen) of null/"none" (geen nachtkast).
  //   nachtkastPrice  = prijs voor 1 nachtkast, nachtkastPrice2 = prijs voor 2.
  nachtkastMode   String?
  nachtkastPrice  Float?
  nachtkastPrice2 Float?
  // Voetbank-optie (bedden), zelfde standen als nachtkast: "included",
  // "optional" (0/1 tegen voetbankPrice) of null/"none".
  voetbankMode    String?
  voetbankPrice   Float?
  featured     Boolean  @default(false)
  stock        Int      @default(10)
  deliveryTime String?
  colorGroup   String?
  colorName    String?
  colorHex     String?
  source       String?   // Herkomst/leverancier (bv. "Rousseau") — admin-tag
  hidden       Boolean  @default(false)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orderItems   OrderItem[]

  @@index([category])
  @@index([colorGroup])
  @@index([hidden])
  @@index([deletedAt])
  @@index([source])
}

// Contactformulier-inzendingen (worden in de admin/DB bewaard; later te
// koppelen aan een e-mailprovider).
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Nieuwsbrief-inschrijvingen.
model NewsletterSubscriber {
  email        String    @id
  createdAt    DateTime  @default(now())
  // Double opt-in: token in de bevestigingsmail; confirmedAt gezet na klik.
  confirmToken String?   @unique
  // Wanneer het huidige confirmToken is uitgegeven; tokens ouder dan 7 dagen
  // worden door /api/cron/cleanup ongeldig gemaakt (ook bij her-aanmelding).
  confirmTokenAt DateTime?
  confirmedAt  DateTime?
  unsubscribedAt DateTime?
}

// Simpele DB-backed rate-limiter (werkt over serverless-instances heen).
// key = bv. "login:<ip>" of "checkout:<ip>"; teller per tijdvenster tot resetAt.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

model DeletedImage {
  id          String   @id @default(cuid())
  productId   String?
  productSlug String
  publicId    String
  url         String   @db.Text
  w           Int?
  h           Int?
  deletedAt   DateTime @default(now())

  @@index([deletedAt])
  @@index([productId])
}

model Order {
  id         String      @id @default(cuid())
  orderNumber String     @unique
  total      Float
  shipping   Float       @default(0)
  status     String      @default("open") // open | paid | failed | canceled | expired | refunded
  molliePaymentId String?
  // Betaalmethode zoals Mollie die meldt (ideal, creditcard, klarna…), gezet bij paid.
  paymentMethod   String?
  paidAt          DateTime?
  // Publieke, niet-raadbare token voor de bedankpagina (i.p.v. het ordernummer).
  publicToken     String?   @unique
  // Wanneer de bevestigingsmail succesvol is verstuurd; null = nog te versturen.
  confirmationSentAt DateTime?
  // Afhandeling door de winkel, los van de betaalstatus:
  //   pending | processing | shipped | delivered | returned
  fulfillmentStatus String   @default("pending")
  trackingCode    String?
  trackingUrl     String?
  shippedAt       DateTime?
  adminNote       String?   @db.Text
  // Google Ads click-id voor server-side conversies.
  gclid           String?
  // Door de checkout meegestuurde sleutel (uuid): een herhaalde submit met
  // dezelfde sleutel hergebruikt de open order + Mollie-checkout i.p.v. een
  // tweede order aan te maken.
  idempotencyKey  String?   @unique
  // Cookie-akkoord op het moment van bestellen; alleen dan sturen we de
  // server-side GA4-purchase (Measurement Protocol).
  analyticsConsent Boolean  @default(false)
  // Betaalde bestellingen worden nooit hard verwijderd (bewaarplicht) maar
  // gearchiveerd: uit de lijst, wel bewaard.
  archivedAt      DateTime?
  firstName  String
  lastName   String
  email      String
  phone      String      @default("")
  address    String
  houseNumber String     @default("")
  city       String
  zipCode    String
  country    String      @default("NL") // ISO-2: NL | BE
  items      OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([status])
  @@index([fulfillmentStatus])
  @@index([createdAt])
  @@index([email])
  @@index([archivedAt])
}

// Oude product-slugs blijven werken na een hernoeming (301 naar het product).
model SlugRedirect {
  id        String   @id @default(cuid())
  oldSlug   String   @unique
  productId String
  createdAt DateTime @default(now())

  @@index([productId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  productName  String  @default("") // snapshot — overleeft prijs/naam-wijziging
  variantLabel String?              // gekozen maat, bv. "140 × 200"
  quantity     Int
  price        Float
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Restrict i.p.v. Cascade: een product definitief verwijderen mag NOOIT de
  // orderregels (omzethistorie) meeslepen. De verwijder-flows slaan producten
  // met bestelgeschiedenis daarom over.
  product      Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // Sessies (JWT) van vóór dit tijdstip zijn ongeldig na een wachtwoordwijziging.
  passwordChangedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
