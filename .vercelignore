# Wordt NIET mee gedeployed naar Vercel.
# Dealer-bronbestanden (zware PDF-catalogi) horen niet op de productie-CDN.
_sources/
public/*.pdf
# Dealer-fotozips (~9 GB) staan in .gitignore maar lokaal wél in public/
public/*.zip

# Eenmalige scripts en lokale data-dumps (niet nodig in runtime).
# Uitzondering: prisma-env.cjs draait tijdens de build (migrate deploy in
# "npm run build"); zonder dit bestand faalt de deploy met MODULE_NOT_FOUND.
scripts/*
!scripts/prisma-env.cjs
photos-todo/
_import-*/

# Docs en notities
STRATEGIE.md
plan.txt
prompt.txt
links.txt
