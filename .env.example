# Database
DATABASE_URL="file:./dev.db"

# Cloudinary (https://cloudinary.com)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Ads (gtag.js) — conversietracking, laadt alleen na cookie-akkoord.
# Leeg laten op dev/preview zodat testverkeer niet meetelt.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversielabel van de "Purchase"-actie in Google Ads (deel na de slash in AW-xxx/LABEL).
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# ─── Beveiliging & platform (toegevoegd bij de backend-hardening) ───
# Geheim voor cron-/beheer-endpoints (/api/cron/*, /api/keep-alive, volledige
# /api/health). Vercel Cron stuurt het automatisch mee als "Authorization: Bearer".
CRON_SECRET=
# NextAuth v5 sessie-secret (min. 32 willekeurige tekens; `openssl rand -base64 32`).
AUTH_SECRET=
# Canonieke publieke URL (zonder slash aan het eind) — voor Mollie-redirect/
# webhook, nieuwsbrief-bevestigingslinks, sitemap en JSON-LD.
NEXT_PUBLIC_BASE_URL=
