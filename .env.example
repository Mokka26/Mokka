# Database
DATABASE_URL="file:./dev.db"

# Cloudinary (https://cloudinary.com)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Ads (gtag.js) — conversietracking, laadt alleen na cookie-akkoord.
# Leeg laten op dev/preview zodat testverkeer niet meetelt.
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversielabel van de "Purchase"-actie in Google Ads (deel na de slash in AW-xxx/LABEL).
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
